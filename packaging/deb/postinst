#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd ophan >/dev/null; then
        useradd --system --user-group --no-create-home --home-dir /nonexistent \
            --shell /usr/sbin/nologin --comment "Ophan gateway" ophan
    fi

    # The service reads its configuration (and TLS keys) as the ophan group.
    if [ -z "$2" ]; then
        chgrp -R ophan /etc/ophan
        chmod -R g+rX /etc/ophan
    fi

    mkdir -p /var/log/ophan /var/www/html
    chown ophan:ophan /var/log/ophan

    for file in index.html favicon.svg; do
        if [ ! -e "/var/www/html/$file" ]; then
            cp "/usr/share/ophan/www/$file" "/var/www/html/$file"
        fi
    done
fi

#DEBHELPER#

# Upgrade: the running gateway hands its listeners over to the new binary (zero downtime).
if [ "$1" = "configure" ] && [ -n "$2" ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    if systemctl is-active --quiet ophan; then
        systemctl reload ophan || systemctl restart ophan
    fi
fi
