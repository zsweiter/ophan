# --- Rust / Cargo ---
# The 'target' directory contains all compiled binaries, build artifacts, and dependencies.
/target/

# --- Backup Files ---
# Generated by Cargo when running commands like `cargo fix`
**/*.rs.bk

# --- Security / Environment ---
# Local environment variables (never commit secret keys, passwords, or API tokens)
.env
.env.*
!.env.example
ophan.json5

# --- IDEs / Editors ---
# JetBrains (IntelliJ, CLion, RustRover)
.idea/
*.iml

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# Vim / Emacs
*~
*.swp
.DS_Store

# --- Testing / Profiling ---
# If you use cargo-tarpaulin or code coverage tools
tarpaulin-report.html
*.profraw

# used for dev
.etc/
archive/
.config/
docs/learn/

# dev artifacts
scripts/copy-certs.sh
perf.data
perf.data.old
scripts/bench.sh


dist/