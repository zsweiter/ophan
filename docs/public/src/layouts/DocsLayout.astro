---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/space-grotesk";

import "@/assets/styles/main.css";
import "@/assets/styles/docs.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Link from "../components/Link.astro";
import type { MarkdownHeading } from "astro";

interface Props {
    title: string;
    description?: string;
    headings?: MarkdownHeading[];
}

const {
    title,
    description = "Ophan API Gateway Docs",
    headings = [],
} = Astro.props;

type SidebarItem = { label: string; href: string; order: number };
type SidebarSection = { title: string; items: SidebarItem[] };

const allDocs = await Astro.glob("../content/docs/*.md");

const tagGroupTitles: Record<string, string> = {
    "getting-started": "Getting Started",
    architecture: "Architecture & Concepts",
    ingress: "Ingress & Networking",
    routing: "Routing & Rewriting",
    security: "Security & Policies",
    upstreams: "Upstreams & Traffic",
    delivery: "Content Delivery",
    operations: "Operations & Observability",
    reference: "Configuration Reference",
    project: "Project & Roadmap",
};

const tagOrder = [
    "getting-started",
    "architecture",
    "ingress",
    "routing",
    "security",
    "upstreams",
    "delivery",
    "operations",
    "reference",
    "project",
];

const grouped = new Map<string, SidebarItem[]>();

for (const doc of allDocs) {
    const fm = doc.frontmatter as Record<string, unknown>;
    const tags = (Array.isArray(fm.tags) ? fm.tags : []) as string[];
    const order = typeof fm.order === "number" ? fm.order : 999;
    const filePath = typeof doc.file === "string" ? doc.file : "";
    const slug = filePath.split("/").pop()?.replace(/\.md$/, "") ?? "";
    const href = slug === "index" ? "/" : `/${slug}`;
    const label = (typeof fm.title === "string" ? fm.title : slug) || slug;

    if (slug === "index") {
        if (!grouped.has("getting-started")) grouped.set("getting-started", []);
        grouped
            .get("getting-started")!
            .push({ label: "Overview", href, order });
        continue;
    }

    for (const tag of tags) {
        if (!grouped.has(tag)) grouped.set(tag, []);
        grouped.get(tag)!.push({ label, href, order });
    }
}

for (const [, items] of grouped) {
    items.sort((a, b) => a.order - b.order);
}

const sidebarItems: SidebarSection[] = tagOrder
    .filter((tag) => grouped.has(tag))
    .map((tag) => ({
        title: tagGroupTitles[tag] ?? tag,
        items: grouped.get(tag)!,
    }));

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="robots" content="noindex, nofollow" />

        <title>{title} | Ophan Docs</title>
        <meta name="description" content={description} />
        <base href={import.meta.env.BASE_URL} />

        <ClientRouter />
    </head>
    <body class="min-h-screen bg-vayload-bg text-neutral-200 font-sans">
        <Header />

        <div class="flex pt-25 mx-auto container !max-w-[96rem]">
            <aside
                class="hidden lg:block w-72 shrink-0 sticky top-25 h-[calc(100vh-5rem)] overflow-y-auto px-6 py-8"
            >
                <nav class="space-y-8">
                    {
                        sidebarItems.map((section) => (
                            <div>
                                <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-3">
                                    {section.title}
                                </h3>
                                <ul class="space-y-1">
                                    {section.items.map((item) => (
                                        <li>
                                            <Link
                                                href={item.href}
                                                class:list={[
                                                    "block px-3 py-2 rounded-lg text-sm transition-all",
                                                    currentPath === item.href ||
                                                    (currentPath.endsWith(
                                                        "/docs",
                                                    ) &&
                                                        item.href === "/docs")
                                                        ? "bg-vayload-accent/10 text-vayload-accent font-medium"
                                                        : "text-neutral-400 hover:text-white hover:bg-white/5",
                                                ]}
                                            >
                                                {item.label}
                                            </Link>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </nav>
            </aside>

            <main class="flex-1 min-w-0 px-6 lg:px-12 py-8 max-w-4xl">
                <article class="docs-content">
                    <div class="callout callout-wip text-sm">
                        <strong>Early-stage software.</strong> Ophan is under active
                        development. Some documented features are still being implemented
                        and may not work as described, but most are already available.
                        Try them and send feedback to
                        <Link href="mailto:zsweiter@gmail.com"
                            >zsweiter@gmail.com</Link
                        >.
                    </div>
                    <slot />
                </article>
            </main>

            <aside
                class="hidden xl:block w-64 shrink-0 sticky top-25 h-[calc(100vh-5rem)] overflow-y-auto px-6 py-8"
            >
                {
                    headings.length > 0 && (
                        <>
                            <div class="text-xs font-bold uppercase tracking-wider text-neutral-500 mb-4 flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-vayload-copper" />
                                On this page
                            </div>
                            <nav class="space-y-2 text-sm text-neutral-400">
                                {headings
                                    .filter(
                                        (h) => h.depth === 2 || h.depth === 3,
                                    )
                                    .map((heading) => (
                                        <Link
                                            href={`#${heading.slug}`}
                                            class:list={[
                                                "block py-1 hover:text-vayload-accent transition-colors",
                                                heading.depth === 3 &&
                                                    "pl-4 border-l border-white/10 ml-1",
                                            ]}
                                        >
                                            {heading.text}
                                        </Link>
                                    ))}
                            </nav>
                        </>
                    )
                }
            </aside>
        </div>

        <Footer />
    </body>
</html>
