---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/space-grotesk";

import "@/assets/styles/main.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description = "Ophan API Gateway" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="robots" content="noindex, nofollow" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="title" content={title} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://zsweiter.github.io/ophan" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />

        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content="https://zsweiter.github.io/ophan" />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />

        <base href={import.meta.env.BASE_URL} />

        <ClientRouter />
    </head>
    <body
        class="min-h-screen bg-vayload-bg text-neutral-200 font-sans selection:bg-vayload-accent/40 selection:text-vayload-cream"
    >
        <Header />
        <main class="relative z-10">
            <slot />
        </main>
        <Footer />
    </body>
</html>
